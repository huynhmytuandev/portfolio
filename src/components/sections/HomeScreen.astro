---
import { Image } from 'astro:assets';

import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { profile, skills } from '../../data/portfolio';
---

<section
  id="glance"
  aria-labelledby="glance-title"
  class="home relative flex flex-col pt-[72px] pb-14 lg:min-h-svh lg:py-[72px]"
>
  <div class="wrap flex flex-1 flex-col gap-7 lg:gap-9">
    <div class="flex flex-col items-center gap-2.5 text-center md:flex-row md:items-end md:justify-between md:gap-12 md:text-left">
      <SectionHeading id="glance-title" eyebrow="About me" title="Hi, I'm Tuan." />
      <p class="max-w-[380px] text-[15px] leading-normal text-os-text-2 md:text-base">{profile.intro}</p>
    </div>

    <div class="grid flex-1 gap-4 lg:grid-cols-[384fr_792fr] lg:gap-6" data-pop-group>
      <!-- Profile -->
      <article class="pop card flex flex-col overflow-hidden rounded-[28px] lg:rounded-[32px]">
        <div class="relative h-[300px] lg:h-auto lg:min-h-[320px] lg:flex-1">
          <Image
            src={profile.avatar}
            alt={profile.avatarAlt}
            widths={[320]}
            sizes="(min-width: 1024px) 384px, 100vw"
            class="absolute inset-0 size-full object-cover object-[center_25%]"
            loading="lazy"
          />
        </div>
        <div class="flex flex-col gap-2 px-5 pt-[18px] pb-[22px] lg:px-6 lg:pt-[22px] lg:pb-[26px]">
          <h3 class="font-display text-[26px] font-bold tracking-[-0.5px]">{profile.name}</h3>
          <p class="text-[15px] leading-[1.45] text-os-text-2">{profile.bio}</p>
        </div>
      </article>

      <!-- My stack -->
      <div
        class="pop glass relative flex flex-col gap-1 rounded-[28px] px-4 pt-4 pb-1 lg:rounded-[32px] lg:p-5"
        style="--i:1"
        data-stack
      >
        <div class="flex min-h-[22px] items-center justify-between px-1 pt-0.5 pb-1 lg:pb-0">
          <h3 class="flex items-center gap-2 text-xs font-bold tracking-[1px] text-os-text-2 uppercase">
            <Icon name="layers" size={16} />
            My stack
          </h3>
          <button
            type="button"
            class="press hidden rounded-full bg-solid px-3 py-1 text-xs font-semibold text-on-solid"
            data-stack-done
          >
            Done
          </button>
        </div>
        <p id="stack-hint" class="sr-only">Press Enter or long-press a tile to wiggle the tiles.</p>
        <ul class="stack-grid grid flex-1 lg:grid-cols-2 lg:grid-rows-4">
          {
            skills.map((s, i) => (
              <li class="stack-cell" style={`--i:${i}`}>
                <button
                  type="button"
                  class="tile press flex h-full w-full items-center gap-3.5 px-1 py-3.5 text-left lg:flex-col lg:items-start lg:justify-between lg:gap-0 lg:px-6 lg:py-5"
                  style={`--j:${i}`}
                  aria-describedby="stack-hint"
                  data-tile
                >
                  <span class="tile-icon grid size-10 shrink-0 place-items-center rounded-xl border border-hair bg-tile-icon text-os-text lg:size-11">
                    <Icon name={s.icon} size={20} />
                  </span>
                  <span class="flex min-w-0 flex-col gap-1">
                    <span class="text-[15px] leading-[1.2] font-semibold lg:text-[17px]">{s.title}</span>
                    <span class="text-[13px] leading-[1.25] text-os-text-3 lg:text-sm">{s.subtitle}</span>
                  </span>
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .home {
    background: var(--bg-home);
  }

  .card {
    background: var(--card);
    border: 1px solid var(--hair);
  }

  .tile {
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }

  /* Hairline grid: rows separated on mobile; 2×4 cells with inner lines on desktop. */
  .stack-cell {
    border-top: 1px solid var(--hair);
  }
  @media (min-width: 1024px) {
    .stack-cell:nth-child(-n + 2) {
      border-top: 0;
    }
    .stack-cell:nth-child(odd) {
      border-right: 1px solid var(--hair);
    }
  }
</style>
