---
// A light phone mock-up with a status bar and an optimized screenshot.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import Icon from './Icon.astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  sizes?: string;
}

const { src, alt, class: className, sizes = '(min-width: 1024px) 220px, 200px' } = Astro.props;
---

<figure
  class:list={[
    'phone flex flex-col overflow-hidden rounded-[26px] border border-(--phone-stroke) bg-[#F9F9F9] shadow-(--phone-shadow) lg:rounded-[32px]',
    className,
  ]}
>
  <div class="flex items-center justify-between px-[22px] pt-3.5 pb-1.5 text-[#111]" aria-hidden="true">
    <span class="text-xs font-semibold">9:41</span>
    <span class="flex items-center gap-1">
      <Icon name="signal" size={12} />
      <Icon name="wifi" size={12} />
      <Icon name="battery-full" size={12} />
    </span>
  </div>
  <Image
    src={src}
    alt={alt}
    widths={[220, 440, 660]}
    sizes={sizes}
    class="block aspect-[220/447] w-full object-cover object-bottom"
    draggable="false"
  />
</figure>
